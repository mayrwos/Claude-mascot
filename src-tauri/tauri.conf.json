{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Mascot",
  "version": "1.3.0",
  "identifier": "dev.claude-mascot.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "claude-mascot contributors",
    "copyright": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Desktop pet for Claude Code",
    "longDescription": "The orange pixel Claude that lives on your desktop and reacts to what Claude Code is doing.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
